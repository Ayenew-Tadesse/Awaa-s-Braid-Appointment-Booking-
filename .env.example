# Copy to .env.local (never commit real values).
# Without the two public Supabase values the site runs as a demo in the browser.

# Public: safe in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# There is no service-role key in this app: nothing here needs to bypass the security rules.
